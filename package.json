{
  "name": "slotbook",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "dev:no-tunnel": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @slotbook/db run generate",
    "db:push": "pnpm --filter @slotbook/db run push",
    "db:migrate": "pnpm --filter @slotbook/db run migrate",
    "db:seed": "pnpm --filter @slotbook/db run seed",
    "db:studio": "pnpm --filter @slotbook/db run studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
