{
  "name": "@slotbook/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "push": "prisma db push",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "seed:demands": "tsx prisma/seed-demands.ts",
    "seed:posts": "tsx prisma/seed-posts.ts",
    "seed:communities": "tsx prisma/seed-communities.ts",
    "backfill:community-covers": "tsx prisma/backfill-community-covers.ts",
    "backfill:usernames": "tsx prisma/backfill-usernames.ts",
    "seed:roles": "tsx prisma/seed-requirement-roles.ts",
    "migrate:category-ids": "tsx prisma/migrate-category-ids.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "bcryptjs": "^2.4.3",
    "@types/bcryptjs": "^2.4.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
